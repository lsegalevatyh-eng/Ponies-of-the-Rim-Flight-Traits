<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="MA_ModuleBase">
    <defName>MA_ModuleArmorReinforcementActive</defName>
    <label>powered reinforced armor plating</label>
    <description>Powered cuirass module. Improves sharp, blunt, and heat protection by 30 percentage points while enabled and powered. Reduces movement speed by 0.1 while operating. Energy consumption: 2 Wh.</description>

    <modExtensions>
      <li Class="ModularArmor.ModuleExtension">
        <forCuirass>true</forCuirass>
        <forHelmet>false</forHelmet>
        <slots>1</slots>
        <installTicks>2500</installTicks>
        <removeTicks>2500</removeTicks>

        <active>true</active>
        <consumption>2</consumption>

        <statOffsets>
          <ArmorRating_Sharp>0.30</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.30</ArmorRating_Blunt>
          <ArmorRating_Heat>0.30</ArmorRating_Heat>
          <MoveSpeed>-0.1</MoveSpeed>
        </statOffsets>
      </li>
    </modExtensions>
  </ThingDef>

