<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- Consolidated flight traits; original modifiers retained. -->
<!-- Balanced trade-offs -->
<TraitDef><defName>FlightTraits_Ace</defName><commonality>1</commonality><label>flight ace</label><description>Confidently handles dangerous stretches, spending more stamina.</description><degreeDatas><li><label>flight ace</label><description>Flight speed +12%; maximum flight stamina -10%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>0.90</maxStaminaFactor><flightSpeedFactor>1.12</flightSpeedFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_Whirlwind</defName><commonality>1</commonality><label>whirlwind</label><description>Accelerates sharply, but tires quickly.</description><degreeDatas><li><label>whirlwind</label><description>Flight speed +25%; maximum flight stamina -25%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>0.75</maxStaminaFactor><flightSpeedFactor>1.25</flightSpeedFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_SmoothFlight</defName><commonality>1</commonality><label>smooth flight</label><description>Conserves stamina at the cost of speed.</description><degreeDatas><li><label>smooth flight</label><description>Maximum flight stamina +20%; flight speed -15%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>1.20</maxStaminaFactor><flightSpeedFactor>0.85</flightSpeedFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_LongHaul</defName><commonality>1</commonality><label>long-haul flyer</label><description>Endures long flights at the cost of speed.</description><degreeDatas><li><label>long-haul flyer</label><description>Maximum flight stamina +25%; flight speed -12%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>1.25</maxStaminaFactor><flightSpeedFactor>0.88</flightSpeedFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_HeavyBreathing</defName><commonality>1</commonality><label>heavy breather</label><description>Recovers slowly after flying.</description><degreeDatas><li><label>heavy breather</label><description>Stamina recovery -25%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><recoveryFactor>0.75</recoveryFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_CautiousFlyer</defName><commonality>1</commonality><label>cautious flyer</label><description>Flies steadily and conserves energy.</description><degreeDatas><li><label>cautious flyer</label><description>Flight speed -15%; maximum flight stamina +15%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>1.15</maxStaminaFactor><flightSpeedFactor>0.85</flightSpeedFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_HeightPanic</defName><commonality>1</commonality><label>height panic</label><description>Gets nervous and quickly runs out of stamina.</description><degreeDatas><li><label>height panic</label><description>Maximum flight stamina -20%; recovery -20%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>0.80</maxStaminaFactor><recoveryFactor>0.80</recoveryFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_IronWings</defName><commonality>1</commonality><label>iron wings</label><description>Stays airborne for a long time, but recovers slowly.</description><degreeDatas><li><label>iron wings</label><description>Maximum flight stamina +25%; recovery -20%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>1.25</maxStaminaFactor><recoveryFactor>0.80</recoveryFactor></li></modExtensions></TraitDef>
<!-- Moderately favorable -->
<TraitDef><defName>FlightTraits_FastRecovery</defName><commonality>0.45</commonality><label>fast recovery</label><description>Recovers noticeably faster, but has a smaller stamina reserve.</description><degreeDatas><li><label>fast recovery</label><description>Stamina recovery +30%; maximum flight stamina -10%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>0.90</maxStaminaFactor><recoveryFactor>1.30</recoveryFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_GuardsWings</defName><commonality>0.45</commonality><label>wing-protective</label><description>Conserves energy by flying more slowly.</description><degreeDatas><li><label>wing-protective</label><description>Maximum flight stamina +25%; flight speed -10%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>1.25</maxStaminaFactor><flightSpeedFactor>0.90</flightSpeedFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_Patrol</defName><commonality>0.45</commonality><label>patroller</label><description>Recovers well between flights, but has a slightly smaller stamina reserve.</description><degreeDatas><li><label>patroller</label><description>Stamina recovery +25%; maximum flight stamina -10%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>0.90</maxStaminaFactor><recoveryFactor>1.25</recoveryFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_AerialAcrobat</defName><commonality>0.45</commonality><label>aerial acrobat</label><description>Fast and agile, but tires quickly.</description><degreeDatas><li><label>aerial acrobat</label><description>Flight speed +20%; maximum flight stamina -15%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>0.85</maxStaminaFactor><flightSpeedFactor>1.20</flightSpeedFactor></li></modExtensions></TraitDef>
<!-- Pure benefits; rare -->
<TraitDef><defName>FlightTraits_Comet</defName><commonality>0.08</commonality><label>comet</label><description>Exceptionally fast and enduring.</description><degreeDatas><li><label>comet</label><description>Flight speed +25%; maximum flight stamina +15%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>1.15</maxStaminaFactor><flightSpeedFactor>1.25</flightSpeedFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_PhoenixBreath</defName><commonality>0.08</commonality><label>phoenix breath</label><description>Has a large stamina reserve and recovers quickly.</description><degreeDatas><li><label>phoenix breath</label><description>Stamina recovery +35%; maximum flight stamina +15%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><recoveryFactor>1.35</recoveryFactor><maxStaminaFactor>1.15</maxStaminaFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_PerfectAerodynamics</defName><commonality>0.08</commonality><label>perfect aerodynamics</label><description>Combines high speed with great endurance.</description><degreeDatas><li><label>perfect aerodynamics</label><description>Flight speed +25%; maximum flight stamina +15%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><flightSpeedFactor>1.25</flightSpeedFactor><maxStaminaFactor>1.15</maxStaminaFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_BornInClouds</defName><commonality>0.08</commonality><label>born in the clouds</label><description>Flies a little faster, stays airborne longer, and recovers faster.</description><degreeDatas><li><label>born in the clouds</label><description>Flight speed, maximum flight stamina, and recovery +15%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>1.15</maxStaminaFactor><recoveryFactor>1.15</recoveryFactor><flightSpeedFactor>1.15</flightSpeedFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_TurboWings</defName><commonality>0.08</commonality><label>turbo wings</label><description>Incredible speed with a slightly larger stamina reserve.</description><degreeDatas><li><label>turbo wings</label><description>Flight speed +35%; maximum flight stamina +10%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><flightSpeedFactor>1.35</flightSpeedFactor><maxStaminaFactor>1.10</maxStaminaFactor></li></modExtensions></TraitDef>
<TraitDef><defName>FlightTraits_IndefatigablePatrol</defName><commonality>0.08</commonality><label>tireless patroller</label><description>Flies for a very long time and recovers quickly.</description><degreeDatas><li><label>tireless patroller</label><description>Maximum flight stamina +30%; recovery +30%.</description></li></degreeDatas><modExtensions><li Class="FlightTraits.FlightTraitExtension"><degree>0</degree><maxStaminaFactor>1.30</maxStaminaFactor><recoveryFactor>1.30</recoveryFactor></li></modExtensions></TraitDef>
</Defs>